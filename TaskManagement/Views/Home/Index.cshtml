@model TaskManagement.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Dashboard</h1>
            </div>
        </div>
    </div>
</div>

@if (User.Identity is { IsAuthenticated: true })
{
    <div class="row">
        <div class="col-lg-3 col-6">
            <div class="small-box bg-info">
                <div class="inner">
                    <h3>@Model.TotalTasks</h3>
                    <p>Total Tasks</p>
                </div>
                <div class="icon">
                    <i class="ion ion-bag"></i>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="small-box bg-success">
                <div class="inner">
                    <h3>@Model.CompletedTasks</h3>
                    <p>Completed Tasks</p>
                </div>
                <div class="icon">
                    <i class="ion ion-stats-bars"></i>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="small-box bg-warning">
                <div class="inner">
                    <h3>@Model.PendingTasks</h3>
                    <p>Pending Tasks</p>
                </div>
                <div class="icon">
                    <i class="ion ion-person-add"></i>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="small-box bg-primary">
                <div class="inner">
                    <h3>@Model.InProgressTasks</h3>
                    <p>In Progress Tasks</p>
                </div>
                <div class="icon">
                    <i class="ion ion-stats-bars"></i>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="small-box bg-danger">
                <div class="inner">
                    <h3>@Model.OverdueTasks</h3>
                    <p>Overdue Tasks</p>
                </div>
                <div class="icon">
                    <i class="ion ion-pie-graph"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Task Status Distribution (Pie Chart)</h3>
                </div>
                <div class="card-body">
                    <canvas id="taskStatusPieChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Recent Pending Tasks</h3>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Task Title</th>
                        <th>Due Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in Model.RecentTasks)
                    {
                        <tr>
                            <td>@task.Task.Title</td>
                            <td>@task.DueDate.ToShortDateString()</td>
                            <td>@task.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @section Scripts {
        <script src="~/lib/adminlte/plugins/chart.js/Chart.min.js"></script>
        <script>
                        var ctxPie = document.getElementById('taskStatusPieChart').getContext('2d');
                        var taskStatusPieChart = new Chart(ctxPie, {
                            type: 'pie',
                            data: {
                                labels: ['Completed', 'Pending', 'In Progress', 'Overdue'],
                                datasets: [{
                                    label: 'Number of Tasks',
                                                        data: [@Model.CompletedTasks, @Model.PendingTasks, @Model.InProgressTasks, @Model.OverdueTasks],
                                                                            backgroundColor: [
                                                                                'rgba(40, 167, 69, 1)', // success
                                                                                'rgba(255, 193, 7, 1)', // warning
                                                                                'rgba(0, 123, 255, 1)', // primary
                                                                                'rgba(220, 53, 69, 1)'  // danger
                                                                            ],                                                        borderColor: [
                                                            'rgba(40, 167, 69, 1)',
                                                            'rgba(255, 193, 7, 1)',
                                                            'rgba(0, 123, 255, 1)',
                                                            'rgba(220, 53, 69, 1)'
                                                        ],                                    borderWidth: 1
                                }]
                            }
                        });
    </script>
}
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="text-center">
                <h1 class="display-4">Welcome</h1>
            </div>
        </div>
    </div>
}
