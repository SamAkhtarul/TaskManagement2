@model List<TaskManagement.Models.AssignedTask>

<a class="nav-link" data-toggle="dropdown" href="#">
    <i class="far fa-bell"></i>
    @if (Model.Count > 0)
    {
        <span class="badge badge-warning navbar-badge">@Model.Count</span>
    }
</a>
<div class="dropdown-menu dropdown-menu-lg dropdown-menu-right">
    <span class="dropdown-item dropdown-header">@Model.Count Pending Tasks</span>
    <div class="dropdown-divider"></div>
    @foreach (var task in Model)
    {
        <a href="#" class="dropdown-item">
            <i class="fas fa-envelope mr-2"></i> @task.Task.Title
            <span class="float-right text-muted text-sm">@task.DueDate.ToShortDateString()</span>
        </a>
        <div class="dropdown-divider"></div>
    }
    <a href="#" class="dropdown-item dropdown-footer">See All Tasks</a>
</div>
