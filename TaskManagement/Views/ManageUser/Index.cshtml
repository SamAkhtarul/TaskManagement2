@model IEnumerable<TaskManagement.ViewModels.UserVM>


<table class="table table-bordered">
    <thead>
        <tr>
            <td>Id</td>
            <td>Name</td>
            <td>Role</td>
            <td>Phone</td>
          
            <td>Email</td>
            <td>Actions</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.UserId</td>
                <td>@role.UserName</td>
                <td>@role.RoleName</td>
                <td>@role.PhoneNumber</td>
           
                <td>@role.Email</td>
                <td>
                    <a asp-action="AssignRole" asp-controller="ManageUser" asp-route-userId="@role.UserId" class="btn btn-warning"><i class="fas fa-user-tag"></i></a>
                    <a asp-action="Delete" asp-controller="ManageUser" asp-route-id="@role.UserId" class="btn btn-danger"><i class="fa fa-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>
